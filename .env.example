# ============================================
# 环境变量模板：复制为 .env 并填入真实值
# .env 已被 .gitignore 排除，切勿提交到仓库
# ============================================

# ---- 平台接口鉴权（抓包获取 X-Access-Token）----
X_ACCESS_TOKEN=<yourAccessToken>

# ---- 平台 Cookie（抓包获取 Cookie 请求头，可选）----
COOKIE=

# ---- 学生试卷参数（抓包获取 URL 中的参数）----
BASE_URL=http://10.191.16.53/oberyun-server/smltplat/theory/thePaper
STUDENT_PAPER_ID=<yourStudentPaperId>
REFER_OBJECT_TYPE=chapter
REFER_OBJECT_ID=<yourReferObjectId>

# ---- AI 答题（openai 库，可换任意 OpenAI 兼容服务）----
OPENAI_API_KEY=sk-REPLACE-ME-YOUR-KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
